emutos*
Disc*
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the two append-only logs below, which are history and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl

**/__pycache__/*

# Emulator inputs we must never commit: disk images, TOS ROMs, savestates
*.st
*.stx
*.img
*.msa
*.sav
*.zip

# Collected data and scratch output from scripts/collect.py
dumps/
tmp/
*.bin
*.bmp
*.png
