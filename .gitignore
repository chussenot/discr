emutos*
Disc*
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the two append-only logs below, which are history and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl

**/__pycache__/*

# Emulator inputs we must never commit: disk images, TOS ROMs, savestates
*.st
*.stx
*.img
*.msa
*.sav
*.zip

# Collected data and scratch output from scripts/collect.py
dumps/
tmp/
*.bin
*.bmp
*.png

# oracle seeds are derived from the disk image
seeds/
*.seed
*.ndjson
oracle/musashi/m68kops.*
oracle/musashi/m68kmake
oracle/disc-oracle
oracle/*.o

# per-agent worktrees
wt/
.claude/worktrees/

# bernstein runtime state: session data, the HMAC audit chain, and the MR
# bodies scripts/loop.sh generates. All derived from a run; bernstein.yaml and
# plans/ are the committed inputs.
.sdd/

# Rust build output
/target/
!tmp/.gitkeep
