emutos*
Disc*
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the two append-only logs below, which are history and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl

**/__pycache__/*

# Emulator inputs we must never commit: disk images, TOS ROMs, savestates
*.st
*.stx
*.img
*.msa
*.sav
*.zip

# Collected data and scratch output from scripts/collect.py
dumps/
tmp/
*.bin
*.bmp
*.png

# oracle seeds are derived from the disk image
seeds/
*.seed
*.ndjson
oracle/musashi/m68kops.*
oracle/musashi/m68kmake
oracle/disc-oracle
oracle/*.o

# per-agent worktrees
wt/
.claude/worktrees/

# bernstein. The workspace SKELETON is committed -- `bernstein doctor` requires
# .sdd, .sdd/backlog and .sdd/runtime to exist (see its _doctor_check_workspace),
# so a fresh clone that lacks them starts one issue down. Everything those
# directories fill with is derived: session data, the HMAC audit chain, saved
# plans, and the MR bodies scripts/loop.sh generates.
.sdd/runtime/*
!.sdd/runtime/.gitkeep
.sdd/backlog/*
!.sdd/backlog/.gitkeep
.sdd/mr/
# bernstein writes its HMAC-SHA256 audit chain here as runs happen; it is
# per-run evidence, not a committed input. (Caught the hard way: the first
# commit of the .sdd skeleton swept a chain lock and a day's JSONL in with it.)
.sdd/audit/

# Rust build output
/target/
!tmp/.gitkeep
